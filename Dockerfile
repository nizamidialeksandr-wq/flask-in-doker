# Образ, на котором всё собирается: Python 3.13 в облегчённой сборке.
FROM python:3.13-slim

# Папка внутри контейнера, в которой будет лежать проект.
WORKDIR /app

# Сначала только зависимости: пока requirements.txt не меняется,
# этот слой берётся из кеша и pip не запускается заново.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Теперь сам код проекта.
COPY . .

# Команда запуска. host 0.0.0.0 обязателен: иначе Flask слушает
# только внутри контейнера и браузер до него не достучится.
CMD ["flask", "--app", "app", "run", "--host", "0.0.0.0", "--port", "5000", "--debug"]
